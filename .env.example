# ============================================================
# 复制为 .env 后填写真实值：cp .env.example .env
# ============================================================

# ---------- 阿里云百炼 DashScope ----------
# qwen-plus 生成模型 + text-embedding-v3（嵌入兜底）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 模型配置 ----------
LLM_PROVIDER=dashscope        # dashscope | mock
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ---------- 嵌入配置 ----------
EMBED_PROVIDER=bge            # bge | dashscope | hash(离线零依赖)
EMBED_MODEL=BAAI/bge-large-zh-v1.5
EMBED_DEVICE=cpu              # cpu | mps | cuda
EMBED_BATCH_SIZE=16

# ---------- 解析配置 ----------
PARSE_BACKEND=auto            # auto | unstructured | pdfplumber
PARSE_STRATEGY=hi_res         # hi_res(布局模型) | fast(纯文本) | ocr_only

# ---------- 切分配置 ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TABLE_MAX_ROWS_PER_CHUNK=20

# ---------- 检索配置 ----------
TOP_K_SUMMARY=6               # 摘要向量召回数量
TOP_K_FINAL=4                 # 进入 LLM 上下文的条目数
ENABLE_RERANK=false
SCORE_THRESHOLD=0.0

# ---------- 存储 ----------
CHROMA_PERSIST_DIR=./storage/chroma
DOCSTORE_DIR=./storage/docstore
CACHE_DIR=./storage/cache
